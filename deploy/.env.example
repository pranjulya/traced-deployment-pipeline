# Copy to deploy/.env and fill with strong random values. Never commit .env.
# Generate with: python3 -c "import secrets;print(secrets.token_urlsafe(48))"

# Client-facing application credential (principal: demo-operator). Required.
P09_APP_SECRET=replace-with-random-application-secret

# Idempotency HMAC secret. Required; rotating it while registry entries exist
# requires the reviewed drain/migration described in the LLD.
P09_HMAC_SECRET=replace-with-random-hmac-secret

# Reserved for the optional real-provider adapter (Project 08). Unused by the
# built-in fake provider, which needs no credential.
P09_PROVIDER_API_KEY=

# Loopback host port for the API.
P09_API_PORT=8080

# Grafana admin password (required by compose; loopback UI only).
P09_GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password

# Deployment revision recorded in traces and release annotations.
P09_REVISION=dev

# Trace head-sampling rate: 1.0 keeps all traces; 0.1 is the sampling experiment.
P09_TRACE_HEAD_RATE=1.0
